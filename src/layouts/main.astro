---
import Analytics from '@vercel/analytics/astro';
import "@/styles/global.css"

const siteUrl = "https://denysov.dev/"
const ogImage = new URL("/og-image.png", siteUrl).href
const title = "Roman Denysov - Software Engineer (React, React Native, Next.js)"
const description =
  "Software engineer in Slovakia working with React, React Native and Next.js. Mobile apps, web applications and internal tools. Open to remote roles across the EU."

const sameAs = [
  "https://github.com/RomanDenysov",
  "https://x.com/RomanDenysov",
  "https://linkedin.com/in/denysov",
]

const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Roman Denysov",
  url: siteUrl,
  image: ogImage,
  jobTitle: "Software Engineer",
  address: { "@type": "PostalAddress", addressCountry: "SK" },
  knowsAbout: ["React", "React Native", "Next.js", "TypeScript"],
  sameAs,
}
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={siteUrl} />
    <meta name="theme-color" content="#ffffff" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Roman Denysov" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Roman Denysov - Software Engineer" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:creator" content="@RomanDenysov" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(person)} />
    <Analytics />
  </head>
  <body class="min-h-svh flex flex-col">
    <main class="mx-auto w-full max-w-4xl flex-1 p-6">
      <slot />
    </main>
    <footer class="mx-auto w-full max-w-4xl p-6">
      <hr class="mb-4" />
      <div class="flex items-center justify-between gap-5">
        <div class="flex items-center gap-3">
          <span class="text-xs tracking-wide text-muted-foreground">© 2026 Roman Denysov · Client work via Ergodic s.r.o.</span>
        </div>
        <div class="flex items-center gap-2 text-sm tracking-tight text-muted-foreground">
          <a
            data-event="email_link_footer"
            class="hover:text-primary hover:underline hover:underline-offset-4"
            href="mailto:hello@denysov.dev"
          >
            hello@denysov.dev
          </a>
          <a
            rel="noopener noreferrer"
            data-event="github_link"
            class="hover:text-primary hover:underline hover:underline-offset-4"
            href="https://github.com/RomanDenysov"
            target="_blank"
          >
            GitHub
          </a>
          <a
            rel="noopener noreferrer"
            data-event="x_link"
            class="hover:text-primary hover:underline hover:underline-offset-4"
            href="https://x.com/RomanDenysov"
            target="_blank"
          >
            X
          </a>
          <a
            rel="noopener noreferrer"
            data-event="linkedin_link"
            class="hover:text-primary hover:underline hover:underline-offset-4"
            href="https://linkedin.com/in/denysov"
            target="_blank"
          >
            LinkedIn
          </a>
        </div>
      </div>
    </footer>
    <script>
      import "@/scripts/tracking"
    </script>
  </body>
</html>
